# Five philosophers, everyone takes the left fork first. Symmetric: Tier B shrinks it.
mutex f1, f2, f3, f4, f5
thread P1:
    lock f1
    lock f2
    unlock f2
    unlock f1
thread P2:
    lock f2
    lock f3
    unlock f3
    unlock f2
thread P3:
    lock f3
    lock f4
    unlock f4
    unlock f3
thread P4:
    lock f4
    lock f5
    unlock f5
    unlock f4
thread P5:
    lock f5
    lock f1
    unlock f1
    unlock f5
